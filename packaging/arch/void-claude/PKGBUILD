# Maintainer: PLAYER99-void <PLAYER99-void@users.noreply.github.com>
# Void, released version (CI attaches the built package to every GitHub release; the -git one follows main).
# After installing, each user runs `void setup` once (their voice + speech models).
pkgname=void-claude
pkgver=1.6.3
pkgrel=1
pkgdesc='Voice-first desktop companion for Claude Code: say "hey Void" and a little orb (or a notch on your screen edge) does the work'
arch=('any')
url='https://github.com/PLAYER99-void/void'
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'webkit2gtk-4.1' 'gtk-layer-shell' 'gst-plugins-base'
         'gst-plugins-good' 'libpulse' 'uv' 'curl')
optdepends=('espeak-ng: fallback voice'
            'grim: screenshots on Hyprland, sway and other wlroots desktops'
            'slurp: picking a screen area'
            'wl-clipboard: clipboard on Wayland'
            'maim: screenshots on X11'
            'xclip: clipboard on X11'
            'libnotify: "done" notifications'
            'playerctl: "pause the music"'
            'brightnessctl: "dim the screen"'
            'alsa-utils: recording without PulseAudio/PipeWire')
makedepends=('meson')
conflicts=('void-claude-git')
install=void-claude.install
source=("void-$pkgver.tar.gz::https://github.com/PLAYER99-void/void/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "void-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "void-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
